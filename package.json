{
  "name": "iac-pr-reviewer",
  "version": "1.0.0",
  "description": "LLM-powered reviewer for Terraform plan changes",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "iac-review": "tsx src/cli.ts",
    "eval": "tsx evals/run.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/meirakrish/iac-pr-reviewer.git"
  },
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/meirakrish/iac-pr-reviewer/issues"
  },
  "homepage": "https://github.com/meirakrish/iac-pr-reviewer#readme",
  "dependencies": {
    "@langchain/anthropic": "^1.5.12",
    "@langchain/core": "^1.2.17",
    "@langchain/openai": "^1.6.2",
    "@meirakrish/llm-kit": "github:meirakrish/llm-kit",
    "commander": "^15.0.0",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  },
  "type": "module",
  "bin": {
    "iac-review": "dist/cli.js"
  },
  "engines": {
    "node": ">=20.11"
  }
}

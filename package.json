{
  "name": "iac-pr-reviewer",
  "version": "1.0.0",
  "description": "LLM-powered reviewer for Terraform plan changes",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/meirakrish/iac-pr-reviewer.git"
  },
  "homepage": "https://github.com/meirakrish/iac-pr-reviewer#readme",
  "bugs": {
    "url": "https://github.com/meirakrish/iac-pr-reviewer/issues"
  },
  "engines": {
    "node": ">=22.19"
  },
  "bin": {
    "iac-review": "dist/cli.js"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "typecheck": "tsc",
    "test": "vitest run",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "iac-review": "tsx src/cli.ts",
    "eval": "tsx evals/run.ts"
  },
  "dependencies": {
    "@langchain/anthropic": "^1.5.12",
    "@langchain/core": "^1.2.17",
    "@langchain/openai": "^1.6.2",
    "@meirakrish/llm-kit": "^0.1.1",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  },
  "packageManager": "pnpm@12.11.2"
}
